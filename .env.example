# ---------------------------------------------------------------------------
# Copy to `.env` and fill in.  NEVER commit the real .env - it is git-ignored.
# Every value here can also be supplied as a plain environment variable /
# Azure app setting; the environment always wins over the file.
# ---------------------------------------------------------------------------

# --- Inputs -----------------------------------------------------------------
WMT_CATEGORY_CSV=config/Walmart_Category_URLs.csv
WMT_STORES_CSV=config/stores.csv
WMT_SELECTORS_JSON=config/selectors.json
WMT_PRIVATE_LABEL_BRANDS_FILE=config/private_label_brands.txt

# --- Outputs ----------------------------------------------------------------
WMT_OUTPUT_DIR=output
WMT_STATE_DIR=state
WMT_QUARANTINE_DIR=quarantine
WMT_DATASET_NAME=walmart_catalog.jsonl
# "date" -> 2026-10-19   |   "iso" -> 2026-10-19T13:45:30+00:00
WMT_CRAWL_DATE_FORMAT=date

# --- Validation gate (atomic file protection) -------------------------------
# A run publishing fewer records than this is withheld and quarantined.
WMT_MIN_RECORDS_PER_RUN=25
WMT_MIN_ITEMS_PER_PAGE=5
WMT_MIN_BODY_BYTES=20000
# Fraction of suspect pages tolerated before the dataset is withheld.
WMT_MAX_SUSPECT_RATIO=0.34
# Blocked pages tolerated before the run aborts early.
WMT_MAX_BLOCKS_PER_RUN=10

# --- Crawl shape ------------------------------------------------------------
WMT_MAX_PAGES_PER_CATEGORY=10
WMT_SCROLL_ENABLED=true
WMT_SCROLL_MAX_ROUNDS=6
WMT_VISIT_PDP=true
WMT_MAX_PDP_PER_CATEGORY=60
WMT_CONCURRENCY=2
WMT_DOWNLOAD_TIMEOUT=60
# Randomised pause before every navigation, in seconds.
WMT_CRAWL_DELAY_MIN=2
WMT_CRAWL_DELAY_MAX=6
WMT_RETRY_TIMES=4
WMT_RETRY_BASE_DELAY=4
WMT_RETRY_MAX_DELAY=90
WMT_RESUME=false

# --- Store / fulfillment context -------------------------------------------
# cookie | ui | cookie_then_ui | off
WMT_STORE_VERIFICATION_MODE=cookie_then_ui
# Keep true: an unverifiable store is skipped instead of producing wrong-location rows.
WMT_REQUIRE_STORE_VERIFIED=true
# pickup | in_store | any
WMT_FULFILLMENT_MODE=any
WMT_EXCLUDE_MARKETPLACE=true
# exclude | include  (shipping-only offers are not local store prices)
WMT_SHIPPING_ONLY_MODE=exclude
WMT_WEIGHT_FROM_TITLE=true
# Optional operator-captured Playwright session (cookies + localStorage).
WMT_STORAGE_STATE=

# --- Audit evidence capture -------------------------------------------------
# Writes output/evidence/<run_id>/ with:
#   store_context_store<id>.json  the store/fulfillment context Walmart resolved into
#                                 the payload + verification outcome + seeded cookies
#   price_evidence_store<id>_<usItemId>.json
#                                 the raw listing tile + raw PDP product payload behind
#                                 the displayed price, plus the exported record
#   evidence_index.json           the list of files captured during the run
# Enough for an independent reviewer to trace a displayed price back to Walmart's
# own response. Off by default; files contain Walmart pages - treat like the dataset.
# Nothing here is committed (output/ is git-ignored). No secrets are written.
WMT_EVIDENCE_ENABLED=false
WMT_EVIDENCE_DIR=output/evidence
WMT_EVIDENCE_MAX_PRODUCTS=2

# --- Pricing / deals policy -------------------------------------------------
# numeric -> "4.99"  |  display -> "$4.99"
WMT_PRICE_FORMAT=numeric
# Leave false: a coupon's stated discount never becomes a price.
WMT_APPLY_COUPON_DISCOUNT=false
WMT_PREFER_EACH_PRICE=true
WMT_INCLUDE_MANUFACTURER_OFFERS=true

# --- Browser ----------------------------------------------------------------
WMT_HEADLESS=true
WMT_BROWSER=chromium
WMT_USE_PLAYWRIGHT=true
WMT_USER_AGENT=
WMT_ALLOWED_DOMAINS=walmart.com

# --- Proxy (secret - keep out of source control) ----------------------------
# WMT_PROXY_URL=http://user:password@proxy.example.com:8080

# --- Azure Blob Storage upload (optional) -----------------------------------
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=walmart-datasets
# AZURE_BLOB_PREFIX=walmart

# --- Logging ----------------------------------------------------------------
WMT_LOG_LEVEL=INFO
# WMT_LOG_FILE=/var/log/walmart-scraper/run.log
